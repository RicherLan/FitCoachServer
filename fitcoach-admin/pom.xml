<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lanprojects</groupId>
        <artifactId>fitcoach-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fitcoach-admin</artifactId>
    <name>FitCoach Admin</name>
    <description>后台管理模块：管理员账号、用户管理、反馈管理、概览统计等接口（前缀 /api/admin/**）</description>

    <dependencies>
        <!-- 通用 ResultCode / BusinessException / BaseEntity / SysConfigService -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-common</artifactId>
        </dependency>

        <!--
            复用 login 模块的 User / UserRepository / SysConfig 等数据层；
            管理员侧不再重复造 user 表，直接读写同一份用户数据。
            JWT 走 admin 模块自己的 AdminJwtUtils（避免与 user token 混用）。
        -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-login</artifactId>
        </dependency>

        <!-- 复用 feedback 模块的 UserFeedback 实体 + Repository（admin 端只查 + 改状态） -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-feedback</artifactId>
        </dependency>

        <!--
            盈利能力三模块（Phase 2 加入）：admin 端直接复用业务模块的 entity + service，
            自己只负责"管理面"的 controller + DTO，不重复实现领域逻辑。
        -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-exercise</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-membership</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-payment</artifactId>
        </dependency>

        <!--
            App 版本管理（Phase 3 加入）：admin 端复用 AppVersionService / AppVersionEntity
            做后台 CRUD，App 端检查更新接口在 fitcoach-appversion 自身。
        -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-appversion</artifactId>
        </dependency>

        <!--
            BCrypt 密码哈希通过 fitcoach-login 模块（PasswordEncoderConfig）统一暴露 Bean，
            admin 模块直接 @Autowired BCryptPasswordEncoder 即可，避免两个模块各自定义 Bean 引发冲突。
        -->

        <!-- JWT（admin token 与 user token 隔离，但底层签发库共用） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>
    </dependencies>
</project>
