<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lanprojects</groupId>
        <artifactId>fitcoach-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fitcoach-admin</artifactId>
    <name>FitCoach Admin</name>
    <description>后台管理模块：管理员账号、用户管理、反馈管理、概览统计等接口（前缀 /api/admin/**）</description>

    <dependencies>
        <!-- 通用 ResultCode / BusinessException / BaseEntity / SysConfigService -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-common</artifactId>
        </dependency>

        <!--
            复用 login 模块的 User / UserRepository / SysConfig 等数据层；
            管理员侧不再重复造 user 表，直接读写同一份用户数据。
            JWT 走 admin 模块自己的 AdminJwtUtils（避免与 user token 混用）。
        -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-login</artifactId>
        </dependency>

        <!-- 复用 feedback 模块的 UserFeedback 实体 + Repository（admin 端只查 + 改状态） -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-feedback</artifactId>
        </dependency>

        <!-- BCrypt 密码哈希 — 仅引 spring-security-crypto 单包，不引整套 Spring Security 重武器 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT（admin token 与 user token 隔离，但底层签发库共用） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>
    </dependencies>
</project>
