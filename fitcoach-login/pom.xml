<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lanprojects</groupId>
        <artifactId>fitcoach-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fitcoach-login</artifactId>
    <name>FitCoach Login</name>
    <description>登录模块：微信登录、JWT 认证、用户管理</description>

    <dependencies>
        <!-- 项目内部 -->
        <dependency>
            <groupId>com.lanprojects</groupId>
            <artifactId>fitcoach-common</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!--
            Nimbus JOSE JWT —— 三方 OIDC idToken 校验专用（阶段 3B）：
              - Apple identityToken：RS256 签名 + iss=https://appleid.apple.com + audience=Bundle ID；
              - Google idToken：RS256 签名 + iss=https://accounts.google.com + audience=OAuth Client ID。
            自带 RemoteJWKSet 内置公钥缓存 + 5min 拉取 + 24h 兜底，不重复造轮子。
            与 jjwt-* 定位不重叠：jjwt-* 仅用于我们自签的 HS256 access/refresh token。
        -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <!-- HTTP Client (调用微信 API) -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-http</artifactId>
        </dependency>

        <!-- 本地缓存（OTP 存储 / 频率限制；多实例部署时可后续切 Redis） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!--
            BCrypt 密码哈希 — 仅引 spring-security-crypto 单包，不引整套 Spring Security 重武器。
            login 模块负责暴露唯一的 BCryptPasswordEncoder Bean，admin 模块通过依赖 fitcoach-login 自动获得。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 腾讯云 SDK 完整包；MockSmsService 不依赖此包的实际类型，
             纯 mock 部署时仅是磁盘多了几 MB 类，spring 不加载 TencentSmsService bean。 -->
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>tencentcloud-sdk-java</artifactId>
        </dependency>
    </dependencies>
</project>
