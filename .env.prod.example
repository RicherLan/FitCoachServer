# ============================================================
# FitCoach Server — 生产环境变量模板
#
# 使用方式：
#   1. cp .env.prod.example .env.prod
#   2. 把所有 "CHANGE_ME_*" 改成你真实的值
#   3. .env.prod 已在 .gitignore，绝对不要 commit
#   4. docker compose --env-file .env.prod -f shell/docker-compose.prod.yml up -d
#
# 安全提示：
#   - 密码至少 16 位，包含大小写字母 + 数字 + 符号
#   - 生成强密码:  openssl rand -base64 24
#   - 上线后务必登录 admin 修改默认 admin/admin123 密码
# ============================================================

# ============================================================
# 一、MySQL 数据库
# ============================================================
# root 密码（mysql 容器初始化用，平时不接触）
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# 业务库名 / 业务用户名 / 业务密码（Spring 用这个连）
MYSQL_DATABASE=fitcoach
MYSQL_USER=fitcoach
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

# Spring 端的数据库连接配置（与上面 MYSQL_* 对齐；host 用 compose 服务名 mysql）
DB_URL=jdbc:mysql://mysql:3306/fitcoach?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=fitcoach
DB_PASSWORD=CHANGE_ME_strong_db_password


# ============================================================
# 二、CORS 白名单（必填！否则前端会被浏览器拒）
# ============================================================
# 多域名用逗号分隔，必须 https（除非内网调试）
# 示例：https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=https://please-change-to-your-real-domain


# ============================================================
# 三、Spring 运行配置
# ============================================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# JVM 内存（2C4G 服务器建议 -Xmx1g；4C8G 可上 -Xmx2g）
JAVA_OPTS=-Xms256m -Xmx1g -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/

# JPA schema 策略：
#   validate (默认/生产) = 只校验表结构，启动时表少了就报错
#   update              = 自动建表/加字段（首次部署 或 加新表/字段时临时用）
#   ⚠️  永远不要设 create/create-drop，会清库！
#   ⚠️  跑完首次部署后，请立即改回 validate 并重启，避免后续误改 schema
JPA_DDL_AUTO=validate

# Admin 默认密码逃生开关（高危）：
#   false (默认/生产) = 启动期校验 admin 密码必须改过；未改则拒启动（安全护栏）
#   true              = 跳过校验；首次部署必须临时设 true 才能启动
#   流程：
#     1. 首次部署：设 true → 启动成功 → 登录 admin/admin123 → 改强密码
#     2. 改完后：改回 false → 重启 → 验证正常启动
#   ⚠️  长期开 true = 安全护栏失效，等于裸奔
ADMIN_ALLOW_DEFAULT_PASSWORD=false


# ============================================================
# 四、Swagger / OpenAPI（生产建议关）
# ============================================================
# false=关闭（默认）；true=临时打开排查接口（排查完务必关回去）
SPRINGDOC_ENABLED=false


# ============================================================
# 五、文件上传（路径在容器内，volume 挂出来）
# ============================================================
UPLOAD_BASE_DIR=/app/uploads
# 走 nginx 反代后，建议保持相对路径 /static，让客户端拼到自己的域名
UPLOAD_URL_PREFIX=/static
UPLOAD_DEFAULT_AVATAR_URL=/assets/default-avatar.svg


# ============================================================
# 六、短信服务（OTP / 通知）
# ============================================================
# mock=本地不真发，OTP 打日志；tencent=腾讯云 SMS（生产）
SMS_PROVIDER=tencent
TENCENT_SECRET_ID=CHANGE_ME_tencent_secret_id
TENCENT_SECRET_KEY=CHANGE_ME_tencent_secret_key
TENCENT_SMS_APP_ID=CHANGE_ME_sdk_app_id
TENCENT_SMS_TEMPLATE_ID=CHANGE_ME_template_id
TENCENT_SMS_SIGN_NAME=FitCoach
TENCENT_SMS_REGION=ap-guangzhou


# ============================================================
# 七、腾讯行为验证码（防刷）
# ============================================================
# 生产强烈建议开启（false 会被脚本批量薅 OTP）
CAPTCHA_ENABLED=true
CAPTCHA_APP_ID=CHANGE_ME_captcha_app_id
CAPTCHA_APP_SECRET_KEY=CHANGE_ME_captcha_secret


# ============================================================
# 八、Nginx（端口 / 域名 / SSL 证书路径）
# ============================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# SSL 证书目录（宿主机路径，挂载到容器 /etc/nginx/certs）
# 用 certbot 申请 Let's Encrypt 免费证书后填进来
SSL_CERT_DIR=/data/fitcoach/certs


# ============================================================
# 九、其他（暂未启用，预留）
# ============================================================
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
