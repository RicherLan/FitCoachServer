<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lanprojects</groupId>
    <artifactId>fitcoach-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>FitCoach Server</name>
    <description>FitCoach AI 健身教练后端服务</description>

    <modules>
        <module>fitcoach-common</module>
        <module>fitcoach-login</module>
        <module>fitcoach-feedback</module>
        <module>fitcoach-log</module>
        <module>fitcoach-clientbus</module>
        <module>fitcoach-exercise</module>
        <module>fitcoach-membership</module>
        <module>fitcoach-payment</module>
        <module>fitcoach-admin</module>
        <module>fitcoach-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.12.5</jjwt.version>
        <hutool.version>5.8.26</hutool.version>
        <caffeine.version>3.1.8</caffeine.version>
        <tencentcloud.version>3.1.1064</tencentcloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 项目内部模块 -->
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-login</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-feedback</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-clientbus</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-exercise</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-membership</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lanprojects</groupId>
                <artifactId>fitcoach-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Hutool 工具库 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-http</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Caffeine 本地缓存（用于 OTP 存储 / 频率限制；后续切 Redis 不影响业务代码） -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- 腾讯云 SDK 完整包（默认不启用，sms.provider=tencent 时才走此实现）。
                 用全集而非分包：分包名/版本会随版本漂移；全集稳定且 maven central 一定能拉到。
                 体积约 50MB，但 spring-boot-maven-plugin 默认不会打入未引用类。 -->
            <dependency>
                <groupId>com.tencentcloudapi</groupId>
                <artifactId>tencentcloud-sdk-java</artifactId>
                <version>${tencentcloud.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块共用的依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
